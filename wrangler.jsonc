{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "agent-visibility-worker",
	"main": "./src/worker/index.ts",
	"compatibility_date": "2025-10-08",
	"upload_source_maps": true,
	"routes": [
		{
			"pattern": "www.danmackenzie.co.uk/.well-known/api-catalog*",
			"zone_name": "danmackenzie.co.uk"
		},
		{
			"pattern": "www.danmackenzie.co.uk/auth.md*",
			"zone_name": "danmackenzie.co.uk"
		},
		{
			"pattern": "www.danmackenzie.co.uk/llms.txt*",
			"zone_name": "danmackenzie.co.uk"
		},
		{
			"pattern": "www.danmackenzie.co.uk/llms-full.txt*",
			"zone_name": "danmackenzie.co.uk"
		},
		{
			"pattern": "www.danmackenzie.co.uk/index.json*",
			"zone_name": "danmackenzie.co.uk"
		},
		{
			"pattern": "www.danmackenzie.co.uk/robots.txt*",
			"zone_name": "danmackenzie.co.uk"
		},
		{
			"pattern": "www.danmackenzie.co.uk/jsonld*",
			"zone_name": "danmackenzie.co.uk"
		},
		{
            "pattern": "www.danmackenzie.co.uk/api",
            "zone_name": "danmackenzie.co.uk"
        },
        {
            "pattern": "www.danmackenzie.co.uk/api/*",
            "zone_name": "danmackenzie.co.uk"
        }

	],
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "./dist/client",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/.well-known/api-catalog",
			"/.well-known/web-bot-auth/*",
			"/api",
			"/api/*",
			"/auth.md",
			"/index.json",
			"/jsonld",
			"/llms-full.txt",
			"/llms.txt",
			"/robots.txt",
			"/*.jsonld",
			"/*.md"
		]
	},
	"ai": {
		"binding": "AI"
	},
	"kv_namespaces": [
		{
			"binding": "VISIBILITY_CACHE",
			"id": "9bd871a960174d6492a1654ace5c5685"
		}
	],
	"vars": {
		"SITE_NAME": "Dan Mackenzie",
		"SITE_DESCRIPTION": "A thoughtful creative practice offering photography, digital support, and AI automation for founder-led brands and individuals.",
		"AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
		"ENRICHMENT_CACHE_TTL": "3600",
		"CONTENT_SIGNAL": "ai-input=yes, search=yes, ai-train=yes",
		"ENABLE_WEB_BOT_AUTH": "true",
		"WORKOS_AUTH_MD_URL": "https://peaceful-resource-23.authkit.app/agent/auth.md",
		"WORKOS_AUTHKIT_DOMAIN": "https://peaceful-resource-23.authkit.app",
		"WORKOS_RESOURCE_INDICATOR": "https://www.danmackenzie.co.uk/"
	}
}